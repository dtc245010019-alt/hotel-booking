# =====================================================================
#  Cấu hình môi trường - Hotel Booking
#  KHÔNG commit file .env thật. Cách tạo .env:
#    ./scripts/setup.sh          # tự sinh .env với mật khẩu ngẫu nhiên mạnh
#  hoặc: cp .env.example .env rồi thay mọi giá trị "change_me..." thủ công.
#  Chỉ dùng ký tự A-Z a-z 0-9 . _ - trong mật khẩu để tránh lỗi escape.
# =====================================================================

# Tên host/IP dùng để truy cập từ trình duyệt (dùng cho đường dẫn tuyệt đối của Grafana)
PUBLIC_HOST=localhost

# ---------------------------------------------------------- PostgreSQL
DB_NAME=hotel
# Superuser của PostgreSQL (chỉ dùng cho quản trị/pgAdmin, app KHÔNG dùng tài khoản này)
DB_USER=hotel_admin
DB_PASSWORD=change_me_db_superuser_password
# Mật khẩu role hotel_app (ứng dụng web, quyền hạn chế)
APP_DB_PASSWORD=change_me_app_db_password
# Mật khẩu role hotel_monitor (postgres-exporter, chỉ đọc thống kê)
MONITOR_DB_PASSWORD=change_me_monitor_db_password

# ------------------------------------------------- Trang quản trị website
ADMIN_USER=admin
# Tối thiểu 12 ký tự
ADMIN_PASSWORD=change_me_admin_password
# Khóa ký cookie phiên, tối thiểu 32 ký tự ngẫu nhiên (openssl rand -hex 32)
SESSION_SECRET=change_me_session_secret_at_least_32_characters

# -------------------------------------------------------------- pgAdmin
# Phải là email hợp lệ (pgAdmin từ chối tên miền đặc biệt như .local)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_pgadmin_password

# -------------------------------------------------------------- Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_grafana_password

# ------------------------------------- Prometheus UI (Basic Auth tại Nginx)
PROMETHEUS_USER=admin
PROMETHEUS_PASSWORD=change_me_prometheus_password
